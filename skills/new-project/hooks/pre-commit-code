#!/usr/bin/env bash
# new-project hook: blocks committing internal Claude files and secrets to the code repo.
PATTERNS="$(dirname "$0")/blocked-patterns"
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E -f "$PATTERNS" | grep -vE '(^|/)\.env\.example$')
if [ -n "$bad" ]; then
  echo "Commit blocked: these files must not be in the code repository:" >&2
  echo "$bad" | sed 's/^/  - /' >&2
  echo "Internal files belong in the private Core repo; secrets belong nowhere in git." >&2
  echo "Unstage them with: git reset <file>" >&2
  exit 1
fi
