#!/usr/bin/env bash
# new-project hook: re-checks pushed commits (catches commits made with --no-verify).
PATTERNS="$(dirname "$0")/blocked-patterns"
remote="$1"; zero=0000000000000000000000000000000000000000
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range=$(git rev-list "$lsha" --not --remotes="$remote")
  else range=$(git rev-list "$rsha..$lsha"); fi
  for c in $range; do
    bad=$(git diff-tree --no-commit-id --name-only -r --diff-filter=ACMR "$c" \
          | grep -E -f "$PATTERNS" | grep -vE '(^|/)\.env\.example$')
    if [ -n "$bad" ]; then
      echo "Push blocked: commit $(git rev-parse --short "$c") contains files that must not be published:" >&2
      echo "$bad" | sed 's/^/  - /' >&2
      echo "Remove them from history before pushing (ask Claude to help)." >&2
      exit 1
    fi
  done
done
exit 0
