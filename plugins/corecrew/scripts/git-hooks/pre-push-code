#!/usr/bin/env bash
# corecrew git hook: re-checks pushed commits (catches commits made with --no-verify).
# blocked-patterns lists what is refused, allowed-patterns the exceptions (.env.example and the like); a missing list
# fails closed, and blank lines of the exceptions are dropped (grep reads an empty pattern as "matches every path").
PATTERNS="$(dirname "$0")/blocked-patterns"; ALLOWED="$(dirname "$0")/allowed-patterns"
for f in "$PATTERNS" "$ALLOWED"; do
  if [ ! -r "$f" ]; then
    echo "Blocked: $f is missing, so internal files can't be checked. Start a new session of the assistant that installed these hooks (Claude Code or Codex) with corecrew enabled to refresh the tools." >&2
    exit 1
  fi
done
remote="$1"; zero=0000000000000000000000000000000000000000
while read -r _ lsha _ rsha; do   # <local ref> <local sha> <remote ref> <remote sha>; the refs are not needed
  [ "$lsha" = "$zero" ] && continue
  # A new branch, or a remote tip this repo never fetched (rev-list cannot read it): every commit that no
  # remote-tracking ref of this remote has. When even that fails, nothing can be checked: the push is blocked.
  if [ "$rsha" = "$zero" ] || ! range=$(git rev-list "$rsha..$lsha" 2>/dev/null); then
    range=$(git rev-list "$lsha" --not --remotes="$remote") || {
      echo "Push blocked: git could not list the commits to push, so they can't be checked." >&2; exit 1; }
  fi
  for c in $range; do
    # (--root: a commit with no parent lists every file it adds)
    bad=$(git -c core.quotePath=false diff-tree --root --no-commit-id --name-only -r --diff-filter=ACMR "$c" \
          | grep -iE -f "$PATTERNS" | grep -viE -f <(grep -v '^[[:space:]]*$' "$ALLOWED"))
    if [ -n "$bad" ]; then
      echo "Push blocked: commit $(git rev-parse --short "$c") contains files that must not be published:" >&2
      echo "$bad" | sed 's/^/  - /' >&2
      echo "Remove them from history before pushing (ask your assistant to help)." >&2
      exit 1
    fi
  done
done
exit 0
