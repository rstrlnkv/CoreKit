#!/usr/bin/env bash
# corecrew git hook: blocks committing internal Claude files and secrets to the code repo.
# blocked-patterns lists what is refused, allowed-patterns the exceptions (.env.example and the like); a missing list
# fails closed, and blank lines of the exceptions are dropped (grep reads an empty pattern as "matches every path").
PATTERNS="$(dirname "$0")/blocked-patterns"; ALLOWED="$(dirname "$0")/allowed-patterns"
for f in "$PATTERNS" "$ALLOWED"; do
  if [ ! -r "$f" ]; then
    echo "Blocked: $f is missing, so internal files can't be checked. Start a new session of the assistant that installed these hooks (Claude Code or Codex) with corecrew enabled to refresh the tools." >&2
    exit 1
  fi
done
bad=$(git diff --cached --name-only -z --diff-filter=ACMR | tr '\0' '\n' | grep -iE -f "$PATTERNS" | grep -viE -f <(grep -v '^[[:space:]]*$' "$ALLOWED"))
if [ -n "$bad" ]; then
  echo "Commit blocked: these files must not be in the code repository:" >&2
  echo "$bad" | sed 's/^/  - /' >&2
  echo "Internal files belong in the private Core repo; secrets belong nowhere in git." >&2
  echo "Unstage them with: git reset <file>" >&2
  exit 1
fi
