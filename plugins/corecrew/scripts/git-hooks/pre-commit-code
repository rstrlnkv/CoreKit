#!/usr/bin/env bash
# corecrew git hook: blocks committing internal Claude files and secrets to the code repo.
PATTERNS="$(dirname "$0")/blocked-patterns"
if [ ! -r "$PATTERNS" ]; then
  echo "Blocked: $PATTERNS is missing, so internal files can't be checked. Start Claude Code once with corecrew enabled to refresh the tools." >&2
  exit 1
fi
bad=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | grep -iE -f "$PATTERNS" | grep -viE '(^|/)\.env\.(example|sample|template)$')
if [ -n "$bad" ]; then
  echo "Commit blocked: these files must not be in the code repository:" >&2
  echo "$bad" | sed 's/^/  - /' >&2
  echo "Internal files belong in the private Core repo; secrets belong nowhere in git." >&2
  echo "Unstage them with: git reset <file>" >&2
  exit 1
fi
