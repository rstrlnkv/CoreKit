#!/usr/bin/env bash
# Saves one working step: commits the code repo and this project's docs in Core
# with the same message and a shared "Step-Id" trailer. The Core commit also carries a
# "Project: <name>" trailer, so undo-step can tell this project's steps that changed only shared
# Core files (knowledge/, standards/ ...) from other projects' steps.
# Usage: save "<message>" [--push] [--no-attribution]
# --push pushes the Core only; the code repo is published by /corecrew:ship (tests, version, merge). With
# --push the message may be left out when there is nothing to save: then only the Core is pushed.
# --no-attribution drops "Co-Authored-By:" lines and lines that start with "Generated with" (after
# optional spaces and a robot emoji) from the message: the user's attribution=forbid setting. A
# subject or body that only mentions "generated with" mid-line stays.
set -u
. "$(dirname "$0")/_locate.sh"
MSG=""; PUSH=0; NOATTR=0
for a in "$@"; do case "$a" in --push) PUSH=1 ;; --no-attribution) NOATTR=1 ;; *) MSG="$a" ;; esac; done
if [ "$NOATTR" = 1 ]; then
  # drop the lines, then trailing blank lines (awk keeps the rest of the message as written)
  MSG="$(printf '%s\n' "$MSG" | grep -viE '^[[:space:]]*co-authored-by:|^[[:space:]]*(🤖[[:space:]]*)?generated with' |
    awk '{ l[NR] = $0 } END { n = NR; while (n > 0 && l[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print l[i] }')"
fi
[ -n "$MSG" ] || [ $PUSH -eq 1 ] || { echo 'Usage: save "<message>" [--push] [--no-attribution]' >&2; exit 2; }
locate || exit 1

# Make sure protective hook shims are in place. With core.hooksPath set (husky, lefthook, a global
# setting) git does not run .git/hooks: install-hooks.sh then exits 4 and explains on stderr how to
# chain corecrew's checks; the step is still saved.
if [ ! -x "$MAIN/.git/hooks/pre-commit" ] || [ ! -x "$MAIN/.git/hooks/pre-push" ] || \
   [ ! -x "$CORE/.git/hooks/pre-push" ] || git -C "$MAIN" config --get core.hooksPath >/dev/null 2>&1 || \
   git -C "$CORE" config --get core.hooksPath >/dev/null 2>&1; then
  rc=0; CORE_DIR="$CORE" bash "$(dirname "$0")/install-hooks.sh" "$PROJECT" >/dev/null || rc=$?
  case "$rc" in 0|4) ;; *) exit 1 ;; esac
fi

# Both repos must be able to commit before the code commit is made, so a step is not left half saved
# for a reason known in advance (can_commit in _locate.sh). The Core is checked only when it has this
# step's docs to commit: a code-only step does not need it (its identity may be set per repo and
# missing there).
# CORE_DIRTY: the Core has changes under CORE_PATHS (a status that fails counts as changes, so the
# check below says what is wrong).
# shellcheck disable=SC2086
CORE_DIRTY=$(git -C "$CORE" status --porcelain -- $CORE_PATHS 2>/dev/null) || CORE_DIRTY=unknown
# --push with no message: allowed only when there is nothing to save (the Core is pushed, nothing is committed)
if [ -z "$MSG" ] && { [ -n "$(git -C "$CODE" status --porcelain 2>/dev/null)" ] || [ -n "$CORE_DIRTY" ]; }; then
  echo 'save: there are changes to save; give them a message: save "<message>" --push' >&2; exit 2
fi
can_commit "$CODE" save "nothing saved" || exit 1
[ -z "$CORE_DIRTY" ] || can_commit "$CORE" save "nothing saved" || exit 1

# Step-Id = <time>-<NN>-<random>. NN counts this project's steps within one second, so undo-step can
# order them (commit times have one-second resolution); the random part (process id and $RANDOM)
# keeps another project's step of the same second apart: its code-only step is not in our repos.
# A step of this second is among the newest commits, so only the latest RECENT commits are read
# (not the whole history of every ref on each call).
RECENT=100
base="$(date +%Y%m%d-%H%M%S)"; n=1; nn=01
while git -C "$CODE" log --all -n "$RECENT" --format=%B 2>/dev/null | grep -q "^Step-Id: $base-$nn-" || \
      git -C "$CORE" log -n "$RECENT" --format=%B 2>/dev/null | grep -q "^Step-Id: $base-$nn-"; do
  n=$((n + 1)); nn="$(printf '%02d' "$n")"
done
ID="$base-$nn-$(printf '%x%04x' "$$" "$RANDOM")"
saved=0; code_sha=""
git -C "$CODE" add -A || { echo "save: git could not write $CODE/.git (read-only? in Codex allow the commit when asked); nothing saved." >&2; exit 1; }
if ! git -C "$CODE" diff --cached --quiet; then
  git -C "$CODE" commit -q -m "$MSG" -m "Step-Id: $ID" || { echo "Code commit failed; nothing saved." >&2; exit 1; }
  code_sha=$(git -C "$CODE" rev-parse --short HEAD)
  echo "saved code ($(git -C "$CODE" rev-parse --abbrev-ref HEAD))"; saved=1
fi
# docs_failed <what> — the Core step failed; say what is already committed and how to finish it.
docs_failed() {
  echo "$1" >&2
  if [ -n "$code_sha" ]; then
    echo "The code commit $code_sha (Step-Id: $ID) was made; the docs were not committed. Fix the cause above, then run save again: it commits the docs as a step of their own." >&2
  fi
  exit 1
}
# The Core is left alone when it has nothing to commit (it was not checked above).
if [ -n "$CORE_DIRTY" ]; then
  # shellcheck disable=SC2086
  git -C "$CORE" add -A -- $CORE_PATHS || docs_failed "save: git could not write $CORE/.git (read-only? in Codex allow the commit when asked)."
  # shellcheck disable=SC2086
  if ! git -C "$CORE" diff --cached --quiet -- $CORE_PATHS; then
    git -C "$CORE" commit -q -m "$MSG" -m "Step-Id: $ID
Project: $NAME" -- $CORE_PATHS || docs_failed "Docs commit failed."
    echo "saved docs"; saved=1
  fi
fi
[ $saved -eq 1 ] || echo "nothing to save"

# Only the Core is pushed: the code repo leaves through ship, after its tests and version. That line
# comes first, so the user learns where the code goes even when the Core push fails (a hook refused it,
# the remote is gone); a failed push still exits 1 and leaves both commits as they are.
if [ $PUSH -eq 1 ]; then
  echo "code not pushed: the code leaves only through corecrew's ship skill"
  if git -C "$CORE" remote get-url origin >/dev/null 2>&1; then
    git -C "$CORE" push -q -u origin HEAD && echo "pushed $(basename "$CORE")" || { echo "Push failed: $CORE" >&2; exit 1; }
  else
    echo "no remote for $(basename "$CORE") — skipped push"
  fi
fi
