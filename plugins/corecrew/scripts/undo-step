#!/usr/bin/env bash
# Undoes the last saved step of THIS project (or the given Step-Id) in both repos with
# git revert. History is kept. All-or-nothing: on a conflict or a failed commit nothing is changed.
# The Core is shared: only the step's own paths are touched, so other projects' staged or unsaved
# Core files stay as they are and never go into the Undo commit.
# Usage: undo-step [STEP_ID]
set -u
. "$(dirname "$0")/_locate.sh"
locate || exit 1

# This project's Core commits: those that touch its folder, and those that touch only the shared
# Core files save commits with it (CORE_PATHS, e.g. knowledge/). A shared-only commit is this
# project's when its "Project:" trailer (written by save and undo-step; older commits have none)
# names it. A commit with no such trailer counts when its Step-Id (or Undo-Of) names a step of this
# code repo (so an old shared-only step with no code commit here is never counted). Only the trailer
# block is read for the project: a "Project:" line in the message body does not count. A commit that
# also touches another project's folder is that project's.
# shellcheck disable=SC2086
core_mine() {
  local x="" p
  for p in $CORE_PATHS; do x="$x :(exclude)$p"; done
  git -C "$CORE" log --format=%H -- "$NAME"
  { git -C "$CODE" log --format=%B | sed -n 's/^Step-Id: /i /p'
    git -C "$CORE" log --format='o %H' -- . $x
    git -C "$CORE" log --format='%x01 %H %(trailers:key=Project,valueonly,separator=%x2C)%n%B' -- $CORE_PATHS; } |
    awk -v name="$NAME" 'BEGIN { m = sprintf("%c", 1) }
         function done_commit() {
           if (h != "" && !(h in o) && (pr != "" ? pr == name : (id != "" && (id in i)))) print h
           h = ""; id = ""; pr = "" }
         $1 == "i" { i[$2] = 1; next }
         $1 == "o" { o[$2] = 1; next }
         $1 == m { done_commit(); h = $2; pr = $3; next }
         /^(Step-Id|Undo-Of): / && h != "" && id == "" { id = $2; next }
         END { done_commit() }'
}
MINE=$(core_mine | awk '!s[$0]++')

# log_of <code|core> <git log args...> — Core history is limited to this project's commits.
log_of() {
  local which="$1"; shift
  if [ "$which" = code ]; then git -C "$CODE" log "$@"
  elif [ -n "$MINE" ]; then printf '%s\n' "$MINE" | git -C "$CORE" log --no-walk --stdin "$@"; fi
}
repo_of() { [ "$1" = code ] && echo "$CODE" || echo "$CORE"; }

# shellcheck disable=SC2086
if [ -n "$(git -C "$CODE" status --porcelain)" ] || \
   [ -n "$(git -C "$CORE" status --porcelain -- $CORE_PATHS)" ]; then
  echo "Unsaved changes in this project. Run save or discard them first." >&2; exit 1
fi

is_undone() { log_of code -n1 --format=%H --grep="^Undo-Of: $1\$" | grep -q . || \
              log_of core -n1 --format=%H --grep="^Undo-Of: $1\$" | grep -q .; }
commits_of() { log_of "$1" --format=%H --grep="^Step-Id: $2\$"; }
# paths_of <code|core> — the paths the step's commits change in that repo, one per line.
paths_of() {
  local c
  for c in $(commits_of "$1" "$ID"); do
    git -C "$(repo_of "$1")" diff-tree --no-commit-id --name-only -r --no-renames -z "$c" | tr '\0' '\n'
  done | sort -u
}
in_head() { git -C "$1" cat-file -e "HEAD:$2" 2>/dev/null; }

ID="${1:-}"
if [ -z "$ID" ]; then
  # Latest not-yet-undone step of this project, by commit time (robust to clock changes); steps of
  # the same second are ordered by the Step-Id, whose <time>-<NN> part save makes increasing.
  ID=$( { log_of code --format='%ct %B'; log_of core --format='%ct %B'; } \
        | awk '/^[0-9]+ /{t=$1} /^Step-Id: /{print t, $2}' | sort -rn -k1,1 -k2,2r | awk '{print $2}' \
        | while read -r i; do is_undone "$i" || { echo "$i"; break; }; done )
fi
[ -n "$ID" ] || { echo "No saved step to undo." >&2; exit 1; }
if is_undone "$ID"; then echo "Step $ID was already undone."; exit 0; fi

# The project's first step created it; undoing it would delete the project and shared files.
for w in code core; do
  for c in $(commits_of "$w" "$ID"); do
    if [ "$(git -C "$(repo_of "$w")" rev-list --parents -n1 "$c" | wc -w | tr -d ' ')" = "1" ]; then
      echo "Step $ID is the project's first step (its creation) and can't be undone with undo-step." >&2
      exit 1
    fi
  done
done

# Every repo the undo commits in must be able to commit, before anything changes.
for w in code core; do
  [ -n "$(commits_of "$w" "$ID")" ] || continue
  can_commit "$(repo_of "$w")" undo-step "nothing was changed" || exit 1
done

# Every path the step changed must be clean, and a path the undo would bring back must not hold a
# local (ignored) file: git would overwrite it, and an aborted undo removes what the revert made.
NEWDIRS=""
for w in code core; do
  r=$(repo_of "$w")
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if [ -n "$(GIT_LITERAL_PATHSPECS=1 git -C "$r" status --porcelain -- "$p")" ] || \
       { ! in_head "$r" "$p" && { [ -e "$r/$p" ] || [ -L "$r/$p" ]; }; }; then
      echo "Could not undo step $ID: $p has local changes or an unsaved local file. Save, move or discard it first." >&2
      exit 1
    fi
    # folders git would create for a file the undo brings back; an aborted undo removes them again
    if ! in_head "$r" "$p"; then
      d=$(dirname "$p")
      while [ "$d" != . ] && [ ! -d "$r/$d" ]; do NEWDIRS="$NEWDIRS$r/$d
"; d=$(dirname "$d"); done
    fi
  done <<< "$(paths_of "$w")"
done

# The index of each repo before the undo (other projects' staged Core files included). The revert can
# change paths the step's commits do not name (a file a later step renamed), so what it changed is
# measured against this tree, and an aborted undo puts exactly those paths back from it.
PRE_CODE=$(git -C "$CODE" write-tree 2>/dev/null) && PRE_CORE=$(git -C "$CORE" write-tree 2>/dev/null) || {
  echo "Could not undo step $ID: a repo has unresolved merge conflicts. Resolve them first." >&2; exit 1; }
pre_of() { [ "$1" = code ] && echo "$PRE_CODE" || echo "$PRE_CORE"; }
OLD_CODE=$(git -C "$CODE" rev-parse -q --verify HEAD); OLD_CORE=$(git -C "$CORE" rev-parse -q --verify HEAD)
old_of() { [ "$1" = code ] && echo "$OLD_CODE" || echo "$OLD_CORE"; }
# changed_of <code|core> — the index paths the revert changed, one per line.
changed_of() { git -C "$(repo_of "$1")" diff-index --cached --name-only -z "$(pre_of "$1")" | tr '\0' '\n'; }

# Phase 1: apply all reverts without committing; on any conflict put back only what the revert touched.
# roll_back <cause> — puts back what the undo changed in each repo it started in, says why nothing was
# changed, and exits 1. A repo whose Undo commit is already made (COMMITTED: <repo>=<sha> words) first
# gets its HEAD moved back to the commit before it, only if HEAD is still that Undo commit. That can be
# only the code repo, committed first and fully clean before (checked above). The Core is never reset:
# its paths are put back one by one, so other projects' staged files stay.
started=""; COMMITTED=""
roll_back() {
  local w r p pre m
  for w in $started; do
    r=$(repo_of "$w"); pre=$(pre_of "$w")
    for m in $COMMITTED; do
      [ "${m%%=*}" = "$w" ] || continue
      git -C "$r" update-ref -m "undo-step: roll back" HEAD "$(old_of "$w")" "${m#*=}" || {
        echo "undo-step: the HEAD of $r moved; its Undo commit ${m#*=} stays." >&2; continue 2; }
    done
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      if git -C "$r" cat-file -e "$pre:$p" 2>/dev/null; then
        GIT_LITERAL_PATHSPECS=1 git -C "$r" checkout -q "$pre" -- "$p" 2>/dev/null
      else   # the revert brought it back; it did not exist before (checked above)
        GIT_LITERAL_PATHSPECS=1 git -C "$r" rm -q -f --cached --ignore-unmatch -- "$p" >/dev/null 2>&1
        rm -f "$r/$p"
      fi
    done <<< "$( { changed_of "$w"; git -C "$r" ls-files -u -z | tr '\0' '\n' | cut -f2-; paths_of "$w"; } | sort -u)"
    git -C "$r" revert --quit 2>/dev/null
  done
  # deepest first; rmdir leaves a folder that is not empty
  printf '%s' "$NEWDIRS" | sort -r | while IFS= read -r d; do [ -n "$d" ] && rmdir "$d" 2>/dev/null; done
  echo "Could not undo step $ID: $1. Nothing was changed." >&2
  exit 1
}
for w in code core; do
  for c in $(commits_of "$w" "$ID"); do
    case " $started " in *" $w "*) ;; *) started="$started $w" ;; esac
    git -C "$(repo_of "$w")" revert --no-commit "$c" >/dev/null 2>&1 || roll_back "it conflicts with later changes"
  done
done
[ -n "$started" ] || { echo "Nothing to undo for step $ID."; exit 0; }

# Phase 2: in each repo, commit only the paths the revert changed; other staged files stay staged. A
# commit can still fail (a pre-commit hook refuses it): then both repos are rolled back. The lines are
# printed once every commit is made.
said=""
for w in $started; do
  r=$(repo_of "$w")
  set --
  while IFS= read -r p; do [ -n "$p" ] && set -- "$@" "$p"; done <<< "$(changed_of "$w")"
  if [ $# -eq 0 ]; then git -C "$r" revert --quit 2>/dev/null; continue; fi
  subj=$(git -C "$r" log -1 --format=%s "$(commits_of "$w" "$ID" | head -1)")
  # the Core commit names the project, like save's: an undo of a shared-only step stays this project's
  trailer="Undo-Of: $ID"; [ "$w" = core ] && trailer="$trailer
Project: $NAME"
  GIT_LITERAL_PATHSPECS=1 git -C "$r" commit -q -m "Undo step $ID: $subj" -m "$trailer" -- "$@" ||
    roll_back "the commit in $r failed (see above)"
  COMMITTED="$COMMITTED $w=$(git -C "$r" rev-parse HEAD)"
  said="${said}reverted $([ "$w" = core ] && echo docs || echo code) ($subj)
"
done
printf '%s' "$said"
